# Шаблон .env. Сам .env в репозиторий не попадает (.gitignore), поэтому на новой
# машине его создают отсюда:
#
#   cp .env.example .env
#
# Значения ниже — то, что отличается от машины к машине: секреты Authentik и
# публичные адреса. Всё остальное живёт в deploy/cluer.yml.

# ------------------------------------------------------------------ секреты
# Генерировать на той машине, где будет работать стек, и никогда не переносить
# из чужой рабочей копии — утёкший ключ подписи Authentik означает возможность
# подделать сессию любого пользователя.
#
#   openssl rand -base64 60 | tr -d '\n'   # для AUTHENTIK_SECRET_KEY
#   openssl rand -base64 36 | tr -d '\n'   # для AUTHENTIK_PG_PASS
#
# AUTHENTIK_PG_PASS меняется только вместе с пересозданием тома authentik-pgdata:
# база уже создана с прежним паролем, и правка одной переменной её не догонит.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=

# Пароль базы приложения. Одна переменная на две стороны: docker-compose ею
# создаёт контейнер postgres, и она же приезжает в сервисы, где viper кладёт её
# в postgres.password. В deploy/cluer.yml пароля поэтому нет.
#
#   openssl rand -base64 24 | tr -d '\n'
#
# Та же оговорка, что и выше: пароль применяется при создании базы. Менять его у
# уже поднятого стека бессмысленно — правка переменной не догонит существующий
# том pgdata, и сервисы перестанут подключаться.
CLUER_POSTGRES_PASSWORD=

# --------------------------------------------------------- публичные адреса
# Оба значения должны указывать на адрес, по которому к серверу обращается
# БРАУЗЕР пользователя, а не контейнер. Значения по умолчанию (в
# docker-compose.yml) годятся только когда браузер запущен на этой же машине.
#
# CLUER_OIDC_ISSUER читают и Go-сервисы (проверка поля iss в токене), и сборка
# фронтенда — это одна переменная на обе стороны, чтобы они не разъехались.
# Authentik формирует issuer из заголовка Host, поэтому значение должно
# совпадать с тем, как к нему постучались, вплоть до завершающего слэша.
#
# CLUER_REDIRECT_URI подставляется в blueprint Authentik и сверяется строго:
# любое расхождение с origin фронтенда даёт ошибку redirect_uri_mismatch на
# этапе логина.
#
# Пример для сервера с адресом 203.0.113.10:
#   CLUER_OIDC_ISSUER=http://203.0.113.10:9000/application/o/cluer/
#   CLUER_REDIRECT_URI=http://203.0.113.10:5173/callback
#
# ВАЖНО: по http на IP вход работать не будет — браузер отдаёт crypto.subtle
# только в secure context (https или localhost), а без него библиотека
# авторизации не может посчитать PKCE-challenge. Схема http годится для показа
# витрины и SDK, но не для входа в админку.
CLUER_OIDC_ISSUER=
CLUER_REDIRECT_URI=

# Идентификатор клиента. Совпадает с client_id в blueprint-части
# deploy/cluer.yml; менять есть смысл, только если завели другого провайдера.
CLUER_OIDC_CLIENT_ID=cluer-admin

# Ключ приложения, под которым SDK онбординга запрашивает сценарии. Берётся из
# админки после создания приложения; пустое значение — SDK не подтянет сценарии.
VITE_CLUER_APP_KEY=
