# Everything that must not end up in the build context: node_modules is
# reinstalled from the lockfile inside the image, the rest is either output or
# local tooling noise.
node_modules
dist
dist-ssr
*.local

.git
.gitignore
.dockerignore
Dockerfile

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs
*.log

.vscode
.idea
.DS_Store
