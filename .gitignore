# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Configuration files
# deploy/cluer.yml is the one config the services actually read: compose mounts
# it into every container as /run/secrets/cluer.yml. It carries the real issuer,
# the database password and anything else that differs per machine, so it stays
# out of the repository. sample_config.yml in the root is the committed template
# it is copied from.
deploy/cluer.yml

# IDE metadata
.[Vv][Ss][Cc]ode*

# docs generated files
docs/*
!docs/swagger.json
!docs/superpowers/
!docs/frontend-auth.md